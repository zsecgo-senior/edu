{
	"extends": [
		"next/core-web-vitals",
		"standard",
		"plugin:tailwindcss/recommended",
		"prettier"
	],
	"rules": {
		"no-use-before-define": "off",
		"react-hooks/rules-of-hooks": "off",
		"no-unused-vars": "off",
		"tailwindcss/classnames-order": "off",
		"no-undef": "off",
		"import/first": "off"
	}
}
